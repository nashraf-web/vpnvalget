---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { site } from '../../../data/site';
import { vpnBySlug } from '../../../data/vpns';
import { breadcrumbSchema } from '../../../data/schema';

const pages = await getCollection('no-vs');
const url = `${site.url}/no/sammenlign/`;
const crumbs = [
  { name: 'Hjem', url: `${site.url}/no/` },
  { name: 'Sammenlign', url },
];
const title = 'Sammenlign VPN-tjenester – side ved side';
const description = 'Sammenlign de beste VPN-tjenestene for Norge side ved side: pris, funksjoner, personvern og brukervennlighet. Ærlige sammenligninger uten betalt rangering.';
---

<Base title={title} description={description} canonical={url} locale="no"
       alternates={{ no: url, 'x-default': url }} schema={[breadcrumbSchema(crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <h1 class="text-3xl sm:text-4xl font-extrabold text-ink mb-4">{title}</h1>
  <p class="text-slate-600 leading-relaxed mb-8 max-w-3xl">{description}</p>
  <div class="grid sm:grid-cols-2 gap-5">
    {pages.map((p) => {
      const a = vpnBySlug(p.data.vpnA)!;
      const b = vpnBySlug(p.data.vpnB)!;
      const href = `/no/sammenlign/${p.id.replace(/\.md$/, '')}/`;
      return (
        <a href={href} class="bg-white border border-slate-200 rounded-2xl p-6 hover:shadow-lg hover:border-brand-500 transition-all">
          <p class="font-extrabold text-lg text-ink">{a.name} <span class="text-slate-400 font-medium">vs</span> {b.name}</p>
          <p class="text-sm text-slate-600 mt-2 line-clamp-2">{p.data.description}</p>
          <p class="text-sm font-semibold text-brand-600 mt-3">Se sammenligning →</p>
        </a>
      );
    })}
  </div>
</Base>
