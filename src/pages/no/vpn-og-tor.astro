const url = `${site.url}/no/vpn-og-tor/`;
const crumbs = [{ name: 'Hjem', url: `${site.url}/no/` }, { name: 'VPN og Tor', url }];
const title = 'VPN og Tor (2026): slik kombinerer du dem – og når du ikke bør';
const description = 'Tor Browser alene er nok for de fleste. Men vil du kombinere VPN og Tor, finnes det to måter – Tor over VPN og VPN over Tor (Onion over VPN) – med helt ulike konsekvenser for anonymiteten din. Slik fungerer de, hvilke VPN-er som har innebygde Tor-servere, og hva Tor Project selv anbefaler. Sjekket 26. november 2026.';
const faqs = [
  {
    question: 'Hva er forskjellen på Tor over VPN og VPN over Tor?',
    answer: 'Ved Tor over VPN kobler du deg først til VPN-en, og så til Tor-nettverket: internettleverandøren din ser bare at du bruker VPN, og Tor-nettverkets første relé ser VPN-serverens adresse – ikke din. Ved VPN over Tor (NordVPN kaller det Onion over VPN) går trafikken først gjennom Tor og så gjennom en VPN-server: Tor-nettverkets siste relé (exit-noden) ser VPN-serveren i stedet for nettsiden du besøker. De to oppsettene beskytter mot ulike ting, og bare Tor over VPN kan brukes sammen med Tor Browser.',
  },
  {
    question: 'Anbefaler Tor Project å bruke VPN sammen med Tor?',
