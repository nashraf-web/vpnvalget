              <td class="p-3 font-semibold text-ink">Surfshark</td>
              <td class="p-3">3,75 USD (ca. 38 kr)</td>
              <td class="p-3">18–20 steder</td>
              <td class="p-3">Kontoen din</td>
              <td class="p-3">30 dager (ikke IP-en)</td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-ink">ExpressVPN</td>
              <td class="p-3">Ca. 4 USD (ca. 40 kr)*</td>
              <td class="p-3">29 byer i 22 land</td>
              <td class="p-3">Anonym kode (token)</td>
              <td class="p-3">30 dager</td>
            </tr>
