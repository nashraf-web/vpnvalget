              <th class="p-3 font-bold text-ink">Knyttet til</th>
              <th class="p-3 font-bold text-ink">Pengene tilbake</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr>
              <td class="p-3 font-semibold text-ink">NordVPN</td>
              <td class="p-3">3,69 USD (ca. 37 kr)</td>
