const url = `${site.url}/no/vpn-og-nettbank/`;
const crumbs = [{ name: 'Hjem', url: `${site.url}/no/` }, { name: 'VPN og nettbank', url }];
const title = 'VPN og nettbank i Norge: DNB, SpareBank 1 og Nordea (2026)';
const description = 'Blir du blokkert i nettbanken når VPN-en er på? Slik bruker du VPN med DNB, SpareBank 1 og Nordea – uten å bli sperret. Norsk server, delt tunnel og steg-for-steg-feilsøking.';
const faqs = [
  {
    question: 'Er det trygt å bruke VPN med nettbank?',
    answer: 'Ja, i utgangspunktet. Nettbanken din bruker allerede sterk kryptering (TLS), så passordet ditt er beskyttet selv uten VPN. VPN-en legger til et ekstra lag som skjuler trafikken din for nettverket du er på – nyttig på offentlig WiFi. Banken ser likevel at du kobler til fra en VPN-server, og det er det som kan utløse sikkerhetskontrollen. Bruk alltid en norsk server til nettbank, og følg bankens egne råd hvis den ber deg om ekstra verifisering.',
  },
  {
    question: 'Hvorfor blokkerer DNB, SpareBank 1 og Nordea meg når VPN-en er på?',
    answer: 'Bankene blokkerer ikke VPN-en som sådan – de reagerer på signalene tilkoblingen gir. Tre ting teller mest: landet IP-adressen din ser ut til å komme fra, om adressen tilhører et datasenter i stedet for en vanlig bredbåndsleverandør, og om den samme adressen har vært brukt til svindel tidligere. Logger du inn fra en utenlandsk VPN-server rett etter at du var logget inn fra Norge, ser det ut som et klassisk tegn på stjålet passord – og da slår svindelvernet inn.',
  },
  {
    question: 'Hvilken VPN-server bør jeg bruke til nettbank?',
    answer: 'Alltid en norsk server – helst Oslo. Da ser banken en norsk IP-adresse, og innloggingen skiller seg ikke fra en vanlig innlogging hjemmefra. Hold deg til det samme landet for alle bankoperasjoner, og ikke bytt server midt i en betaling. Alle VPN-ene vi anbefaler har servere i Norge ifølge leverandørene selv.',
  },
  {
    question: 'Hva er delt tunnel, og hvorfor hjelper det med nettbank?',
    answer: 'Delt tunnel (split tunneling) lar deg velge hvilke apper som skal gå via VPN og hvilke som skal bruke vanlig internett. Setter du nettbank-appen og BankID-appen til å gå utenom VPN-en, ser banken din vanlige norske IP-adresse – og resten av trafikken din er fortsatt beskyttet. NordVPN, Surfshark og ExpressVPN har alle delt tunnel i appene sine. Slik gjør du det, forklarer vi i guiden om hva delt tunnel er.',
  },
  {
    question: 'Kan jeg bruke Vipps og BankID med VPN på?',
    answer: 'Som regel ja. Vipps og BankID er mindre strenge på IP-adresser enn selve nettbanken, og de fleste bruker dem med VPN påslått uten problemer – særlig via en norsk server. Skulle Vipps nekte en betaling, er det nesten alltid nok å bytte til en norsk server eller skru av VPN-en i noen sekunder mens betalingen går gjennom. Mer om dette i guiden om VPN og BankID.',
  },
  {
    question: 'Hva gjør jeg hvis banken har sperret kontoen min?',
    answer: 'Slå først av VPN-en og logg inn på vanlig måte fra din vanlige IP-adresse – ofte er det nok til å låse opp. Virker ikke det, kontakt bankens kundeservice via de offisielle kanalene (app, nettside eller telefonnummeret på bankkortet ditt) og forklar at du brukte VPN. Del aldri BankID-koder eller passord med noen som ringer deg – banken ber aldri om det. Ikke prøv å «lure» banken med nye servere; det gjør bare svindelvernet mer mistenksomt.',
