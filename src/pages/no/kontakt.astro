---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../data/site';
import { breadcrumbSchema } from '../../data/schema';

const url = `${site.url}/no/kontakt/`;
const crumbs = [{ name: 'Hjem', url: `${site.url}/no/` }, { name: 'Kontakt', url }];
const title = 'Kontakt VPNValget';
const description = 'Kontakt VPNValget: spørsmål, tips, rettelser eller samarbeid. Vi svarer vanligvis innen to virkedager.';
---

<Base title={title} description={description} canonical={url} locale="no"
       alternates={{ no: url, 'x-default': url }} schema={[breadcrumbSchema(crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <article class="max-w-3xl">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-ink mb-6">Kontakt oss</h1>
    <div class="text-slate-700 leading-relaxed space-y-5">
      <p>Har du spørsmål om en VPN-tjeneste, funnet en feil på siden, eller ønsker du å tipse oss om noe vi bør teste? Vi hører gjerne fra deg.</p>
      <div class="bg-white border border-slate-200 rounded-2xl p-6">
        <p class="font-semibold text-ink mb-1">E-post</p>
        <p><a class="text-brand-600 hover:underline font-medium" href={`mailto:${site.email}`}>{site.email}</a></p>
        <p class="text-sm text-slate-500 mt-3">Vi svarer vanligvis innen to virkedager.</p>
      </div>
      <h2 class="text-2xl font-extrabold text-ink pt-2">Rettelser</h2>
      <p>Oppdager du feil faktainformasjon? Send oss gjerne en e-post med kilden din, så retter vi opp og merker endringen med ny oppdateringsdato. Nøyaktighet er en av kjerneverdiene våre.</p>
      <h2 class="text-2xl font-extrabold text-ink pt-2">Samarbeid</h2>
      <p>Vi inngår ikke avtaler som påvirker rangeringer eller vurderinger. Redaksjonell uavhengighet er ikke til salgs.</p>
    </div>
  </article>
</Base>
