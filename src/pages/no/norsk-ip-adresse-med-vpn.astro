const description = 'Trenger du norsk IP-adresse fra utlandet? Slik får du den med VPN i 2026 – for NRK, BankID, Vipps og nettbank. NordVPN har over 90 servere i Oslo. Steg-for-steg-guide med priser i kroner.';
const faqs = [
