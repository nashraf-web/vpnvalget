---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Stars from '../../../components/Stars.astro';
import { site } from '../../../data/site';
import { vpnBySlug } from '../../../data/vpns';
import { breadcrumbSchema } from '../../../data/schema';

const reviews = await getCollection('no-reviews');
const url = `${site.url}/no/anmeldelser/`;
const crumbs = [
  { name: 'Hjem', url: `${site.url}/no/` },
  { name: 'Anmeldelser', url },
];
const title = 'VPN-anmeldelser 2026 – ærlige tester for Norge';
const description = 'Les våre ærlige VPN-anmeldelser for det norske markedet. Vi vurderer personvern, funksjoner, pris og brukervennlighet – uten betalt rangering.';
---

<Base title={title} description={description} canonical={url} locale="no"
       alternates={{ no: url, 'x-default': url }} schema={[breadcrumbSchema(crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <h1 class="text-3xl sm:text-4xl font-extrabold text-ink mb-4">{title}</h1>
  <p class="text-slate-600 leading-relaxed mb-8 max-w-3xl">{description} Karakterene er våre redaksjonelle vurderinger, og faktaopplysninger er hentet fra leverandørenes offisielle spesifikasjoner.</p>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {reviews.map((r) => {
      const vpn = vpnBySlug(r.data.vpn)!;
      const href = `/no/anmeldelser/${r.id.replace(/\.md$/, '')}/`;
      return (
        <a href={href} class="bg-white border border-slate-200 rounded-2xl p-6 hover:shadow-lg hover:border-brand-500 transition-all group">
          <p class="font-extrabold text-lg text-ink group-hover:text-brand-600">{vpn.name}</p>
          <p class="text-xs text-brand-700 font-semibold mt-1">{vpn.bestFor}</p>
          <div class="my-3"><Stars rating={vpn.rating} size="sm" /></div>
          <p class="text-sm text-slate-600 line-clamp-3">{r.data.description}</p>
          <p class="text-sm font-semibold text-brand-600 mt-3">Les anmeldelse →</p>
        </a>
      );
    })}
  </div>
</Base>
