const faqs = [
  {
    question: 'Er «no-logs» det samme som anonymitet?',
    answer: 'Nei. No-logs betyr at VPN-leverandøren ikke lagrer en oversikt over hva du gjør på nett – men du kan fortsatt identifiseres på andre måter: innlogginger, informasjonskapsler, nettleser-fingeravtrykk og GPS-posisjon på mobil. No-logs fjerner én sporingsvei (leverandørens logger), ikke alle. Full anonymitet på nett er i praksis umulig.',
  },
  {
    question: 'Hva er forskjellen på tilkoblingslogger og aktivitetslogger?',
    answer: 'Aktivitetslogger (bruklogger) viser hva du gjorde: hvilke nettsider du besøkte, filer du lastet ned, når og hvor lenge. Tilkoblingslogger er metadata: at du koblet til, hvilket tidspunkt, hvor mye data du brukte – men ikke hva du gjorde. Seriøse no-logs-VPN-er lagrer ingen av delene permanent, men noen beholder aggregerte, anonyme tilkoblingsdata i kort tid for å holde tjenesten i drift.',
