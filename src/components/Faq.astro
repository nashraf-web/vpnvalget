---
import type { Faq } from '../data/schema';
interface Props { faqs: Faq[]; heading?: string }
const { faqs, heading = 'Ofte stilte spørsmål' } = Astro.props;
---

<section aria-label={heading} class="my-12">
  <h2 class="text-2xl font-extrabold text-ink mb-6">{heading}</h2>
  <div class="space-y-3">
    {faqs.map((f) => (
      <details class="group bg-white border border-slate-200 rounded-xl px-5 py-4 open:shadow-sm">
        <summary class="font-semibold text-ink cursor-pointer list-none flex justify-between items-center gap-4">
          {f.question}
          <span class="text-brand-500 text-xl leading-none group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 text-slate-600 leading-relaxed">{f.answer}</p>
      </details>
    ))}
  </div>
</section>
