---
// Newsletter signup — posts to Brevo (sibforms) endpoint.
// List: "vpnvalget subscribers". GDPR: consent checkbox required.
---
<section class="newsletter" aria-labelledby="newsletter-heading">
  <div class="newsletter-inner">
    <h2 id="newsletter-heading">Få VPN-tips på e-post</h2>
    <p class="newsletter-sub">
      Meld deg på nyhetsbrevet vårt og få de beste VPN-tilbudene og
      sikkerhetstipsene først. Ingen spam — meld deg av når som helst.
    </p>
    <form
      class="newsletter-form"
      method="POST"
      action="https://c3225b10.sibforms.com/serve/MUIFACa_g1P3PrAjWoSODo3rH17IOEIhkMA7RLiKXqRneWNuwk1konVMAwW0KpLhBcN7XmahgZYWEF-OqqDVd9GNztug-WCD8OOGld5qrpKlXh563qPY8dt_IUefzIGt01ujoNHKdgoSJdFTIFzQKE-OIG3OIKcQnEyl1TrJ7Gn6IpyTIQwn4Tiw-o8Je97KH-yL7GQoO8H_s34_ZA=="
      data-type="subscription"
    >
      <div class="newsletter-row">
        <label class="sr-only" for="newsletter-email">E-postadresse</label>
        <input
          id="newsletter-email"
          class="newsletter-input"
          type="email"
          name="EMAIL"
          placeholder="Din e-postadresse"
          autocomplete="email"
          required
        />
        <button class="newsletter-btn" type="submit">Meld meg på</button>
      </div>
      <label class="newsletter-consent">
        <input type="checkbox" name="OPT_IN" value="1" required />
        <span>
          Jeg samtykker til å motta nyhetsbrev fra VPNValget på e-post.
          Du kan melde deg av når som helst via lenken i e-posten.
          Les vår <a href="/no/personvern/">personvernerklæring</a>.
        </span>
      </label>
      <input type="text" name="email_address_check" value="" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="locale" value="no" />
    </form>
    <p class="newsletter-note">Vi deler aldri e-postadressen din med tredjeparter.</p>
  </div>
</section>

<style>
  .newsletter {
    background: linear-gradient(135deg, #0f2a4a 0%, #1a4a7a 100%);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    margin: 3rem 0;
    color: #fff;
  }
  .newsletter-inner { max-width: 560px; margin: 0 auto; text-align: center; }
  .newsletter h2 { margin: 0 0 0.5rem; font-size: 1.6rem; color: #fff; }
  .newsletter-sub { opacity: 0.9; margin: 0 0 1.5rem; }
  .newsletter-row { display: flex; gap: 0.5rem; }
  .newsletter-input {
    flex: 1;
    padding: 0.85rem 1rem;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
  }
  .newsletter-btn {
    padding: 0.85rem 1.5rem;
    background: #f5a623;
    color: #1a1a1a;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .newsletter-btn:hover { background: #ffbe4d; }
  .newsletter-consent {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    text-align: left;
    font-size: 0.8rem;
    opacity: 0.85;
    margin-top: 1rem;
  }
  .newsletter-consent a { color: #ffd98a; }
  .newsletter-note { font-size: 0.8rem; opacity: 0.7; margin: 1rem 0 0; }
  .sr-only {
    position: absolute; width: 1px; height: 1px;
    overflow: hidden; clip: rect(0 0 0 0);
  }
  .hp { position: absolute; left: -9999px; }
  @media (max-width: 560px) {
    .newsletter-row { flex-direction: column; }
    .newsletter-btn { width: 100%; }
  }
</style>
