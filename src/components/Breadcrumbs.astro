---
import type { Crumb } from '../data/schema';
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---

<nav aria-label="Brødsmuler" class="text-sm text-slate-500 mb-6">
  <ol class="flex flex-wrap items-center gap-1.5">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="text-slate-300">/</span>}
        {i === crumbs.length - 1
          ? <span aria-current="page" class="text-slate-700 font-medium">{c.name}</span>
          : <a href={c.url} class="hover:text-brand-600 hover:underline">{c.name}</a>}
      </li>
    ))}
  </ol>
</nav>
