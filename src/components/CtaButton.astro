---
/**
 * Affiliate CTA button — ALWAYS paired with ANNONSE disclosure (Norwegian law).
 * Links to /go/{brand}; target swapped to Compado after approval.
 */
import { goUrl } from '../data/site';
interface Props {
  brand: string;
  label?: string;
  sub?: string;
  variant?: 'primary' | 'secondary';
}
const { brand, label = 'Besøk tilbudet', sub, variant = 'primary' } = Astro.props;
const styles = variant === 'primary'
  ? 'bg-brand-500 hover:bg-brand-600 text-white'
  : 'bg-white hover:bg-slate-100 text-brand-700 border border-brand-500';
---

<div class="affiliate-cta">
  <a href={goUrl(brand)}
     rel="sponsored nofollow noopener"
     class={`inline-flex flex-col items-center justify-center gap-0.5 font-bold px-6 py-3 rounded-xl transition-colors text-center ${styles}`}>
    <span>{label}</span>
    {sub && <span class="text-xs font-medium opacity-90">{sub}</span>}
  </a>
  <p class="text-[11px] text-slate-500 mt-1.5 text-center">
    <span class="font-semibold uppercase tracking-wide">Annonse</span> – affiliatelenke. Vi kan motta provisjon uten ekstra kostnad for deg.
  </p>
</div>
