---
interface Props { pros: string[]; cons: string[] }
const { pros, cons } = Astro.props;
---

<div class="grid md:grid-cols-2 gap-4 my-8">
  <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-5">
    <p class="font-bold text-emerald-800 mb-3">✅ Fordeler</p>
    <ul class="space-y-2 text-sm text-slate-700">
      {pros.map((p) => <li class="flex gap-2"><span aria-hidden="true">•</span><span>{p}</span></li>)}
    </ul>
  </div>
  <div class="bg-rose-50 border border-rose-200 rounded-xl p-5">
    <p class="font-bold text-rose-800 mb-3">⚠️ Ulemper</p>
    <ul class="space-y-2 text-sm text-slate-700">
      {cons.map((c) => <li class="flex gap-2"><span aria-hidden="true">•</span><span>{c}</span></li>)}
    </ul>
  </div>
</div>
